<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/stopwatch_notification_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="10dp">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="#1E40AF"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STUDY SESSION"
            android:textColor="#BFDBFE"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/notification_stopwatch_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format="%s"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/notification_stop_button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/stopwatch_notification_stop_bg"
        android:minWidth="60dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="STOP"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
